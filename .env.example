# Postgres connection string. On Vercel, adding the Prisma Postgres storage
# integration with prefix "NUWEBSTORAGE" sets this automatically (its sibling
# NUWEBSTORAGE_PRISMA_DATABASE_URL is a prisma+postgres:// Accelerate URL and
# is not used here). For local dev, point it at a local/dev Postgres instance
# (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres` then
# NUWEBSTORAGE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuweb").
NUWEBSTORAGE_DATABASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
