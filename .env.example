# Postgres connection strings. On Vercel, adding the Postgres (Neon) storage
# integration sets these automatically. For local dev, point both at the same
# local/dev Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`
# then DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuweb").
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
